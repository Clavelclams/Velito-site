# HUB Velito : variables d'environnement (12/11/2026)
# Copier en .env.local et remplir. NE JAMAIS mettre de valeur ici : ce
# fichier est commité, il ne sert qu'à dire QUELLES variables existent.

# Supabase (même projet pour toutes les apps). Runtime en priorité,
# NEXT_PUBLIC_* en repli pour le dev local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret absolu : service_role. "Sensitive" sur Vercel, jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=

# SSO entre sous-domaines : ".velito.fr" en prod, vide en dev local.
COOKIE_DOMAIN=

# Adresses des autres apps (lues seulement en dev ; en prod elles sont en dur).
NEXT_PUBLIC_HUB_URL=http://localhost:3000
NEXT_PUBLIC_VEA_URL=http://localhost:3001
NEXT_PUBLIC_VENA_URL=
NEXT_PUBLIC_INTERACTIVE_URL=
NEXT_PUBLIC_ARENA_URL=http://localhost:3003
NEXT_PUBLIC_COURS_URL=

# Espace personnel cours.velito.fr : adresses autorisées, séparées par des virgules.
COURS_EMAILS_AUTORISES=
